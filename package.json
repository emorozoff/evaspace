{
  "name": "evaspace",
  "private": true,
  "version": "1.0.0",
  "description": "Eva Space — платформа женского развития с индивидуальной программой обучения",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
