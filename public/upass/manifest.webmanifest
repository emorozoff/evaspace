{
  "id": "/evaspace/upass/",
  "name": "UPASS — цифровой паспорт резидента",
  "short_name": "UPASS",
  "description": "Приложение закрытого кооператива: паспорт резидента, сеть UHOME в двадцати городах, доля в активах через UHT, репутация и общее управление.",
  "start_url": "/evaspace/upass/",
  "scope": "/evaspace/upass/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#07080c",
  "theme_color": "#07080c",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["social", "lifestyle", "travel", "finance"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/evaspace/upass/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/evaspace/upass/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/evaspace/upass/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Карта UHOME", "short_name": "Карта", "url": "/evaspace/upass/#/map", "icons": [{ "src": "/evaspace/upass/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Чаты", "short_name": "Чаты", "url": "/evaspace/upass/#/chats", "icons": [{ "src": "/evaspace/upass/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Люди", "short_name": "Люди", "url": "/evaspace/upass/#/people", "icons": [{ "src": "/evaspace/upass/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
